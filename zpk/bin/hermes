#!/bin/sh
set -eu

APP_ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
HERMES_SRC="$APP_ROOT/lib/hermes-agent"
HERMES_PYTHON="$HERMES_SRC/venv/bin/python"
HERMES_SCRIPT="$HERMES_SRC/venv/bin/hermes"
HERMES_LAUNCHER="$APP_ROOT/libexec/hermes-secure-launcher.py"

if [ ! -x "$HERMES_PYTHON" ]; then
    echo "hermes python is not ready: $HERMES_PYTHON" >&2
    exit 127
fi

if [ ! -f "$HERMES_SCRIPT" ]; then
    echo "hermes script is not ready: $HERMES_SCRIPT" >&2
    exit 127
fi

if [ ! -f "$HERMES_LAUNCHER" ]; then
    echo "hermes secure launcher is not ready: $HERMES_LAUNCHER" >&2
    exit 127
fi

export HERMES_HOME="${HERMES_HOME:-${ZETTLAB_CLAW_DATA_DIR:-/volume1/system/zettos-main-data/com.zettlab.claw}/hermes_home}"
export HERMES_BUNDLED_SKILLS="${HERMES_BUNDLED_SKILLS:-$HERMES_SRC/skills}"
export HERMES_BUNDLED_PLUGINS="${HERMES_BUNDLED_PLUGINS:-$HERMES_SRC/plugins}"
export HERMES_BUNDLED_LOCALES="${HERMES_BUNDLED_LOCALES:-$HERMES_SRC/locales}"
exec "$HERMES_PYTHON" -I "$HERMES_LAUNCHER" "$HERMES_SCRIPT" "$@"
