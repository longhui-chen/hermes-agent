[Unit]
Description=Hermes Agent Multiplex Gateway
Wants=network.target
After=network.target

[Service]
Type=simple
EnvironmentFile=-__APP_BASE__/data/secrets/hermes-agent-mux.env
Environment=HERMES_HOME=__APP_BASE__/data/hermes_home
Environment=HERMES_BUNDLED_SKILLS=__APP_BASE__/current/lib/hermes-agent/skills
Environment=HERMES_BUNDLED_PLUGINS=__APP_BASE__/current/lib/hermes-agent/plugins
Environment=ZET_AGENT_ENABLED=true
Environment=ZET_AGENT_HOST=127.0.0.1
Environment=ZET_AGENT_PORT=7900
ExecStart=__APP_BASE__/current/bin/hermes gateway run --force --accept-hooks
Restart=on-failure
RestartSec=3
TimeoutStopSec=210
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
