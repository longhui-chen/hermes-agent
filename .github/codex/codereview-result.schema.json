{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "important": {
      "type": "integer",
      "minimum": 0
    },
    "nit": {
      "type": "integer",
      "minimum": 0
    },
    "pre_existing": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["important", "nit", "pre_existing"]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["severity", "file", "line", "title"]
      }
    }
  },
  "required": ["verdict", "important", "nit", "pre_existing", "issues"]
}
